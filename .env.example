# Conexion de solo lectura a la base del observatorio.
# Apunta al endpoint que CONTIENE los datos, y nunca comitees el valor real: vive
# en el entorno de la plataforma que hospeda (el panel de Coolify, hoy).
DASHBOARD_DATABASE_URL=postgres://usuario:clave@host:5432/economic_observatory

# TLS exigido y certificado verificado, que es el comportamiento por omision.
# Ponlo en 'false' solo cuando la base se alcanza por una red privada de Docker
# que no sirve TLS: ahi el handshake se rechaza y la pagina se queda sin una sola
# cifra, asi que exigirlo no compra nada. Una base en loopback queda exenta sola,
# sin declarar nada. Ver src/lib/db.ts.
# DASHBOARD_DATABASE_SSL=false

# Asistente «Preguntale al Observatorio» (src/lib/asistente). Sin clave, el panel
# dice que no está disponible y POST /api/asistente responde 503; nada más depende
# de ella. La clave solo la lee el servidor.
# OPENROUTER_API_KEY=
# ASISTENTE_MODELO=google/gemini-3.1-flash-lite-preview
# Preguntas por IP cada diez minutos, consultas simultáneas y tope diario de tokens.
# ASISTENTE_POR_IP=40
# ASISTENTE_SIMULTANEAS=4
# ASISTENTE_TOKENS_DIA=4000000
