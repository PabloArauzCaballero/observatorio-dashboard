# Conexion de solo lectura a la base del observatorio.
# Apunta al endpoint que CONTIENE los datos, y nunca comitees el valor real: vive
# en el entorno de la plataforma que hospeda (el panel de Coolify, hoy).
DASHBOARD_DATABASE_URL=postgres://usuario:clave@host:5432/economic_observatory

# TLS exigido y certificado verificado, que es el comportamiento por omision.
# Ponlo en 'false' solo cuando la base se alcanza por una red privada de Docker
# que no sirve TLS: ahi el handshake se rechaza y la pagina se queda sin una sola
# cifra, asi que exigirlo no compra nada. Una base en loopback queda exenta sola,
# sin declarar nada. Ver src/lib/db.ts.
# DASHBOARD_DATABASE_SSL=false

# Asistente «Preguntale al Observatorio» (src/lib/asistente). Las claves solo las
# lee el servidor. Cada pregunta recorre la cadena (src/lib/asistente/cadena.ts):
# OpenRouter → Gemini directo → modelo gratuito de OpenRouter, con los que tengan
# clave. Sin ninguna, o si todos fallan, contesta SIN IA con las cifras del tablero.
# OPENROUTER_API_KEY=
# ASISTENTE_MODELO=google/gemini-3.1-flash-lite-preview
# Respaldo con la capa gratuita de Google (clave de https://aistudio.google.com).
# Por defecto usa el mismo modelo que ASISTENTE_MODELO, sin el prefijo google/.
# GEMINI_API_KEY=
# ASISTENTE_MODELO_GEMINI=
# Modelos gratuitos de OpenRouter como último respaldo, separados por coma: no gastan
# crédito, pero tienen cupo diario (bajo sin crédito cargado) y a veces se saturan.
# ASISTENTE_MODELO_GRATIS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# Debajo de este saldo (US$), GET /api/asistente dice saldo «bajo» y el workflow
# saldo-ia.yml abre un aviso.
# ASISTENTE_SALDO_MINIMO=2
# Preguntas por IP cada diez minutos, consultas simultáneas y tope diario de tokens.
# ASISTENTE_POR_IP=40
# ASISTENTE_SIMULTANEAS=4
# ASISTENTE_TOKENS_DIA=4000000
